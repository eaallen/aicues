rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: levelScores/{levelId}/entries
    // Document ID: authenticated uid (one high score per player per field)
    // Fields:
    //   - uid: string (required, immutable) — must equal auth.uid and doc ID
    //   - levelId: string (required, immutable) — whitelist below, must match path
    //   - name: string (required) — exactly 3 characters A-Z
    //   - score: number (required) — integer 0..999999
    //   - createdAt: timestamp (required, immutable) — request.time on create
    //   - updatedAt: timestamp (required) — request.time on create and update
    //
    // Updates may raise score only. Deletes are denied.
    // No PII: arcade initials only.
    //
    // Collection: cueUsers/{uid}/prompts/{promptId}
    // Document ID: client-generated prompt id
    // Fields:
    //   - title: string (required) — 1..80 characters
    //   - body: string (required) — 0..100000 characters
    //   - createdAt: integer millis (required, immutable)
    //   - updatedAt: integer millis (required) — >= createdAt, not decreased
    //   - isPublic: boolean (optional) — when true, anyone may read the prompt
    //
    // Access: signed-in Google/email owners read/write; public read when isPublic == true.
    // No PII is stored in prompt documents.
    //
    // Document: cueUsers/{uid}
    // Fields:
    //   - tag: string (required) — 3..32 chars, lowercase slug
    //   - updatedAt: integer millis (required)
    //
    // Access: owner read/write; public read when tag is present (public wallet).
    // No email or other PII on this document.
    //
    // Collection: userTags/{tag}
    // Document ID: normalized tag
    // Fields:
    //   - uid: string (required) — owner uid
    //
    // Access: public get (signed-out wallet resolves tag → uid); no list;
    // create when absent and uid matches auth; delete by owner only; no update.
    //
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /levelScores/{levelId}/entries/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        isValidScoreEntry(request.resource.data) &&
        request.resource.data.uid == userId &&
        request.resource.data.levelId == levelId &&
        isKnownLevel(levelId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidScoreEntry(request.resource.data) &&
        uidNotModified() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.levelId == resource.data.levelId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.score > resource.data.score &&
        isKnownLevel(levelId);
      allow delete: if false;
    }

    match /cueUsers/{uid} {
      // Split allows so owner get() works when the profile doc does not exist yet
      // (prompts live in a subcollection; the parent cueUsers/{uid} is created
      // only when a tag is set). Combining owner || resource.data in one rule
      // denies reads of missing documents.
      allow get: if isAccountOwner(uid);
      allow get: if resource.data.tag is string;
      allow create: if isAccountOwner(uid) &&
        isValidCueProfile(request.resource.data);
      allow update: if isAccountOwner(uid) &&
        isValidCueProfile(request.resource.data);
      allow delete: if isAccountOwner(uid);
    }

    match /userTags/{tag} {
      allow get: if true;
      allow create: if isAccountUser() &&
        !exists(/databases/$(database)/documents/userTags/$(tag)) &&
        hasOnlyAllowedFields(['uid']) &&
        hasRequiredFields(['uid']) &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isAccountUser() &&
        resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /cueUsers/{uid}/prompts/{promptId} {
      // Split owner vs public so an unfiltered owner list query is not rejected
      // for lacking where("isPublic", "==", true).
      allow get, list: if isAccountOwner(uid);
      allow get, list: if resource.data.isPublic == true;
      allow create: if isAccountOwner(uid) &&
        isValidCuePrompt(request.resource.data) &&
        request.resource.data.createdAt == request.resource.data.updatedAt;
      allow update: if isAccountOwner(uid) &&
        isValidCuePrompt(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isAccountOwner(uid);
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAccountUser() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAccountOwner(uid) {
      return isAccountUser() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isKnownLevel(levelId) {
      return levelId in [
        'training',
        'meadow',
        'hamlet',
        'siege',
        'sprinter',
        'tank',
        'watchman',
        'cleaver',
        'ember',
        'colossus',
        'twins'
      ];
    }

    function isValidScoreEntry(data) {
      return hasOnlyAllowedFields([
          'uid',
          'levelId',
          'name',
          'score',
          'createdAt',
          'updatedAt'
        ]) &&
        hasRequiredFields([
          'uid',
          'levelId',
          'name',
          'score',
          'createdAt',
          'updatedAt'
        ]) &&
        uidUnchanged() &&
        data.uid is string &&
        data.uid == request.auth.uid &&
        data.levelId is string &&
        isKnownLevel(data.levelId) &&
        data.name is string &&
        data.name.matches('^[A-Z]{3}$') &&
        data.score is number &&
        data.score == int(data.score) &&
        data.score >= 0 &&
        data.score <= 999999 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCuePrompt(data) {
      return hasOnlyAllowedFields(['title', 'body', 'createdAt', 'updatedAt', 'isPublic']) &&
        hasRequiredFields(['title', 'body', 'createdAt', 'updatedAt']) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        data.body is string &&
        data.body.size() <= 100000 &&
        data.createdAt is number &&
        data.createdAt == int(data.createdAt) &&
        data.createdAt > 0 &&
        data.updatedAt is number &&
        data.updatedAt == int(data.updatedAt) &&
        data.updatedAt >= data.createdAt &&
        (!('isPublic' in data) || data.isPublic is bool);
    }

    function isValidCueProfile(data) {
      return hasOnlyAllowedFields(['tag', 'updatedAt']) &&
        hasRequiredFields(['tag', 'updatedAt']) &&
        isValidUserTag(data.tag) &&
        data.updatedAt is number &&
        data.updatedAt == int(data.updatedAt) &&
        data.updatedAt > 0;
    }

    function isValidUserTag(tag) {
      return tag is string &&
        tag.size() >= 3 &&
        tag.size() <= 32 &&
        tag.matches('^[a-z0-9]([a-z0-9-]*[a-z0-9])?$');
    }
  }
}
