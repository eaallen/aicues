rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: levelScores/{levelId}/entries
    // Document ID: authenticated uid (one high score per player per field)
    // Fields:
    //   - uid: string (required, immutable) — must equal auth.uid and doc ID
    //   - levelId: string (required, immutable) — whitelist below, must match path
    //   - name: string (required) — exactly 3 characters A-Z
    //   - score: number (required) — integer 0..999999
    //   - createdAt: timestamp (required, immutable) — request.time on create
    //   - updatedAt: timestamp (required) — request.time on create and update
    //
    // Updates may raise score only. Deletes are denied.
    // No PII: arcade initials only.
    //
    // Collection: cueUsers/{uid}/prompts/{promptId}
    // Document ID: client-generated prompt id
    // Fields:
    //   - title: string (required) — 1..80 characters
    //   - body: string (required) — 0..100000 characters
    //   - createdAt: integer millis (required, immutable)
    //   - updatedAt: integer millis (required) — >= createdAt, not decreased
    //   - publicTag: string (optional) — 2..32, matches public tag rules; when
    //     present, publicPrompts/{publicTag} must exist
    //
    // Access: signed-in Google/email owners only. Anonymous auth is denied.
    // No PII is stored in prompt documents.
    //
    // Collection: publicPrompts/{tag}
    // Document ID: share tag (same value as the tag field)
    // Fields:
    //   - tag: string (required, immutable) — must equal document ID
    //   - promptId: string (required, immutable) — owner's private prompt id
    //   - ownerUid: string (required, immutable) — must equal auth.uid
    //   - title: string (required) — 1..80 characters
    //   - body: string (required) — 0..100000 characters
    //   - createdAt: integer millis (required, immutable)
    //   - updatedAt: integer millis (required) — >= createdAt, not decreased
    //
    // Access: unauthenticated read (public wallet / share links).
    // Writes: signed-in Google/email owner of the matching private prompt.
    // Anonymous auth is denied. No PII is stored.
    //
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /levelScores/{levelId}/entries/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        isValidScoreEntry(request.resource.data) &&
        request.resource.data.uid == userId &&
        request.resource.data.levelId == levelId &&
        isKnownLevel(levelId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidScoreEntry(request.resource.data) &&
        uidNotModified() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.levelId == resource.data.levelId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.score > resource.data.score &&
        isKnownLevel(levelId);
      allow delete: if false;
    }

    match /cueUsers/{uid}/prompts/{promptId} {
      allow read: if isAccountOwner(uid);
      allow create: if isAccountOwner(uid) &&
        isValidCuePrompt(request.resource.data) &&
        request.resource.data.createdAt == request.resource.data.updatedAt &&
        publicTagExistsIfPresent(request.resource.data);
      allow update: if isAccountOwner(uid) &&
        isValidCuePrompt(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt >= resource.data.updatedAt &&
        publicTagExistsIfPresent(request.resource.data);
      allow delete: if isAccountOwner(uid);
    }

    match /publicPrompts/{tag} {
      allow read: if true;
      allow create: if isAccountUser() &&
        isValidPublicPrompt(request.resource.data) &&
        isValidPublicTag(tag) &&
        !isReservedPublicTag(tag) &&
        request.resource.data.tag == tag &&
        request.resource.data.ownerUid == request.auth.uid &&
        ownedPromptExists(request.resource.data.promptId);
      allow update: if isAccountUser() &&
        resource.data.ownerUid == request.auth.uid &&
        isValidPublicPrompt(request.resource.data) &&
        isValidPublicTag(tag) &&
        !isReservedPublicTag(tag) &&
        request.resource.data.tag == tag &&
        request.resource.data.tag == resource.data.tag &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.promptId == resource.data.promptId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isAccountUser() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAccountUser() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAccountOwner(uid) {
      return isAccountUser() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isKnownLevel(levelId) {
      return levelId in [
        'training',
        'meadow',
        'hamlet',
        'siege',
        'sprinter',
        'tank',
        'watchman',
        'cleaver',
        'ember',
        'colossus',
        'twins'
      ];
    }

    function isValidScoreEntry(data) {
      return hasOnlyAllowedFields([
          'uid',
          'levelId',
          'name',
          'score',
          'createdAt',
          'updatedAt'
        ]) &&
        hasRequiredFields([
          'uid',
          'levelId',
          'name',
          'score',
          'createdAt',
          'updatedAt'
        ]) &&
        uidUnchanged() &&
        data.uid is string &&
        data.uid == request.auth.uid &&
        data.levelId is string &&
        isKnownLevel(data.levelId) &&
        data.name is string &&
        data.name.matches('^[A-Z]{3}$') &&
        data.score is number &&
        data.score == int(data.score) &&
        data.score >= 0 &&
        data.score <= 999999 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMillis(value) {
      return value is number &&
        value == int(value) &&
        value > 0;
    }

    function isValidCuePrompt(data) {
      return hasOnlyAllowedFields([
          'title',
          'body',
          'createdAt',
          'updatedAt',
          'publicTag'
        ]) &&
        hasRequiredFields(['title', 'body', 'createdAt', 'updatedAt']) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        data.body is string &&
        data.body.size() <= 100000 &&
        isValidMillis(data.createdAt) &&
        isValidMillis(data.updatedAt) &&
        data.updatedAt >= data.createdAt &&
        (!('publicTag' in data) || isValidPublicTag(data.publicTag));
    }

    function publicTagExistsIfPresent(data) {
      return !('publicTag' in data) ||
        exists(/databases/$(database)/documents/publicPrompts/$(data.publicTag));
    }

    function isValidPublicTag(tag) {
      return tag is string &&
        tag.size() >= 2 &&
        tag.size() <= 32 &&
        tag.matches('^[a-z][a-z0-9]*(-[a-z0-9]+)*$');
    }

    function isReservedPublicTag(tag) {
      return tag in [
        'about',
        'api',
        'app',
        'assets',
        'auth',
        'login',
        'static',
        'w',
        'wallet',
        'www'
      ];
    }

    function ownedPromptExists(promptId) {
      return promptId is string &&
        promptId.size() > 0 &&
        exists(/databases/$(database)/documents/cueUsers/$(request.auth.uid)/prompts/$(promptId));
    }

    function isValidPublicPrompt(data) {
      return hasOnlyAllowedFields([
          'tag',
          'promptId',
          'ownerUid',
          'title',
          'body',
          'createdAt',
          'updatedAt'
        ]) &&
        hasRequiredFields([
          'tag',
          'promptId',
          'ownerUid',
          'title',
          'body',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidPublicTag(data.tag) &&
        !isReservedPublicTag(data.tag) &&
        data.promptId is string &&
        data.promptId.size() > 0 &&
        data.promptId.size() <= 64 &&
        data.ownerUid is string &&
        data.ownerUid == request.auth.uid &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        data.body is string &&
        data.body.size() <= 100000 &&
        isValidMillis(data.createdAt) &&
        isValidMillis(data.updatedAt) &&
        data.updatedAt >= data.createdAt;
    }
  }
}
